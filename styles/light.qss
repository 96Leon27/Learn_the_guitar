/* Основное окно */
QWidget {
    background-color: #f5f5f5;
    color: #2c3e50;
    font-family: 'Segoe UI', 'Arial', sans-serif;
}

/* Кнопки: градиент, тень, анимация при наведении и нажатии */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #f0f0f0, stop:1 #e0e0e0);
    border: 1px solid #bdbdbd;
    border-radius: 6px;
    padding: 6px 12px;
    color: #2c3e50;
    font-weight: bold;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #ffffff, stop:1 #f0f0f0);
    border-color: #9e9e9e;
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #d0d0d0, stop:1 #c0c0c0);
    padding-top: 7px;
    padding-bottom: 5px;
}
QPushButton:focus {
    outline: none;
    border-color: #6a9fb5;
}

/* Поля ввода и текстовые поля */
QLineEdit, QTextEdit {
    background-color: white;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 4px 8px;
    color: #2c3e50;
    selection-background-color: #c1d5e0;
}
QLineEdit:focus, QTextEdit:focus {
    border-color: #6a9fb5;
    background-color: #fefef7;
}
QLineEdit:hover, QTextEdit:hover {
    border-color: #b0b0b0;
}

/* Таблица */
QTableWidget {
    background-color: white;
    alternate-background-color: #fafafa;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    gridline-color: #e0e0e0;
}
QTableWidget::item:selected {
    background-color: #c1d5e0;
    color: #1a2b3c;
}
QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #f0f0f0, stop:1 #e0e0e0);
    font-weight: bold;
    color: #2c3e50;
    border: 1px solid #d0d0d0;
    padding: 4px;
}
QTableCornerButton::section {
    background-color: #e8e8e8;
}

/* Полоса прокрутки */
QScrollBar:vertical {
    background: #e8e8e8;
    width: 12px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background: #c0c0c0;
    border-radius: 6px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}
QScrollBar::handle:vertical:pressed {
    background: #909090;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: #e8e8e8;
    height: 12px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal {
    background: #c0c0c0;
    border-radius: 6px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover {
    background: #a0a0a0;
}
QScrollBar::handle:horizontal:pressed {
    background: #909090;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Слайдер громкости */
QSlider::groove:horizontal {
    border: 1px solid #d0d0d0;
    height: 6px;
    background: #e0e0e0;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 #a0a0a0, stop:1 #c0c0c0);
    border: 1px solid #b0b0b0;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #c0c0c0;
    width: 16px;
    margin: -5px 0;
}
QSlider::handle:horizontal:pressed {
    background: #909090;
}
QSlider::sub-page:horizontal {
    background: #6a9fb5;
    border-radius: 3px;
}

/* Строка состояния */
QStatusBar {
    background-color: #fafafa;
    border-top: 1px solid #e0e0e0;
    color: #5a6b7a;
}
QStatusBar::item {
    border: none;
}

/* Всплывающие подсказки */
QToolTip {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 2px 4px;
}